<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tiles per row, for the dock and the app grid. Keep it equal to the number of dock apps. -->
    <integer name="columns">5</integer>
    <!-- Dock apps, left to right, by package name. Missing packages are skipped. -->
    <string-array name="dock_apps">
        <item>org.smarttube.stable</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>org.jellyfin.androidtv</item>
    </string-array>
    <!-- Never shown in the grid. Factory apps can switch the TV into factory mode if opened. -->
    <string-array name="hidden_apps">
        <item>com.mitv.bspfactoryservice</item>
    </string-array>
    <!-- Package opened by "Live TV" in the Inputs menu. -->
    <string name="live_tv_package">com.mitv.livetv</string>
    <!-- Remote button that opens live_tv_package (needs the KeyService accessibility service on).
         192 = the PatchWall button on the Xiaomi remote (KEY_WWW in getevent). -->
    <integer name="live_tv_keycode">192</integer>
</resources>
